[Unit]
Description=Encore
After=network-online.target
Wants=network-online.target

[Service]
User=encore
WorkingDirectory=/opt/encore
EnvironmentFile=/etc/encore.env
ExecStart=/opt/encore/.venv/bin/uvicorn encore.app:create_app --factory --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/encore/var

[Install]
WantedBy=multi-user.target
