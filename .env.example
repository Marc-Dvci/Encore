# Qloo hackathon key (sent only as the X-Api-Key header, from the server).
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# Gemini on Vertex AI (API key). Without it Encore writes session words from templates.
GEMINI_API_KEY=
ENCORE_AI_PROVIDER=gemini
ENCORE_GEMINI_MODEL=gemini-3.7-flash
# Live model calls stop after this date and past these caps; templates keep working.
ENCORE_AI_UNTIL=2026-11-30
ENCORE_AI_DAILY_CAP=600
ENCORE_AI_PER_VISITOR_HOURLY=40
# Where the database, the private Qloo cache and the image cache live.
# ENCORE_DATA_DIR=./var
